---
import { ClientRouter } from 'astro:transitions';
import  Header  from './components/Header.astro';
import  Navbar  from './components/Navbar.astro';
import { Toaster } from "@/components/ui/toast"
import "../styles/global.css";
interface Props {
  title?: string;
}
 
const { title = "CRM" } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<!-- Basic Icons -->
		<link href="https://cdn.boxicons.com/3.0.8/fonts/basic/boxicons.min.css" rel="stylesheet">
		<!-- Filled Icons -->
		<link href="https://cdn.boxicons.com/3.0.8/fonts/filled/boxicons-filled.min.css" rel="stylesheet">
		<!-- Brand Icons -->
		<link href="https://cdn.boxicons.com/3.0.8/fonts/brands/boxicons-brands.min.css" rel="stylesheet">
		<ClientRouter></ClientRouter>
	</head>
	<body>
		<div class="min-h-screen w-full">
			<div class="pl-15 header">
				<Header section='Comercial' subsection='gestion de leads'  ></Header>
			</div>
			<div class="flex min-h-[calc(100vh-4rem)] w-full">
				<nav class="">
					<Navbar></Navbar>
				</nav>
				<main class="flex-1 px-20">
					
					<slot />
					
				</main>
			</div>
		</div>
		<Toaster client:load></Toaster>

	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
