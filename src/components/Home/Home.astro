<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let leadsChart = null;
    function setText(id, value) {
        const element = document.getElementById(id);

        if (!element) {
            console.warn(`Elemento #${id} no encontrado`);
            return;
        }

        element.textContent = value;
    }
    function renderLeadsChart(stages) {

    const canvas = document.getElementById("leadsChart");

    if (!canvas) return;

    const total =
        stages["Bandeja"] +
        stages["Contacto sin respuesta"] +
        stages["Seguimiento"] +
        stages["Lead tracking"] +
        stages["Desestimado"];

    setText("chart-total", total);

    setText("legend-bandeja", stages["Bandeja"])   

    setText("legend-sin-respuesta",stages["Contacto sin respuesta"])
    
    setText("legend-seguimiento",stages["Seguimiento"])

    setText("legend-tracking",stages["Lead tracking"])

    setText("legend-desestimado",stages["Desestimado"])

    if (leadsChart) {
        leadsChart.destroy();
    }


    leadsChart = new Chart(canvas, {

        type: "doughnut",

        data: {

        labels: [
            "Bandeja",
            "Contacto sin respuesta",
            "Seguimiento",
            "Lead Tracking",
            "Desestimado"
        ],

        datasets: [{
            data: [
            stages["Bandeja"],
            stages["Contacto sin respuesta"],
            stages["Seguimiento"],
            stages["Lead tracking"],
            stages["Desestimado"]
            ],

            backgroundColor: [
            "#6366f1",
            "#fb923c",
            "#60a5fa",
            "#10b981",
            "#9ca3af"
            ],

            borderWidth: 0,

            hoverOffset: 5
        }]

        },

        options: {

        responsive: true,

        maintainAspectRatio: false,

        cutout: "72%",

        plugins: {

            legend: {
            display: false
            },

            tooltip: {
            callbacks: {
                label: function(context) {

                const value = context.raw;

                const percentage =
                    total > 0
                    ? ((value / total) * 100).toFixed(1)
                    : 0;

                return ` ${value} leads (${percentage}%)`;
                }
            }
            }

        }

        }

    });

    }  
  async function loadDashboard() {

    try {

      // =========================
      // LEADS
      // =========================

      const leadsResponse = await fetch("/api/Leads");
      const leads = await leadsResponse.json();
      setText("total-leads", leads.length);


      // =========================
      // ETAPAS
      // =========================

      const stages = {
        "Bandeja": 0,
        "Contacto sin respuesta": 0,
        "Seguimiento": 0,
        "Lead tracking": 0,
        "Desestimado": 0
      };


      leads.forEach((lead) => {

        const stage = lead.etapa || lead.stage;

        if (stage && stages[stage] !== undefined) {
          stages[stage]++;
        }

      });
      renderLeadsChart(stages)

      setText("lead-tracking",stages["Lead tracking"])
      
      setText("stage-bandeja",stages["Bandeja"])
      
      setText("stage-sin-respuesta",stages["Contacto sin respuesta"])

      setText("stage-seguimiento",stages["Seguimiento"])
      
      setText("stage-tracking",stages["Lead tracking"])

      setText("stage-desestimado",stages["Desestimado"]) 


      // =========================
      // PROYECTOS
      // =========================

      const projectsResponse = await fetch("/api/Projects");
      const projects = await projectsResponse.json();
      console.log("Poryectos",projects)
      
      setText("total-projects",projects.length);


    } catch (error) {

      console.error(
        "Error cargando dashboard:",
        error
      );

    }

  }


  document.addEventListener("astro:page-load", () => {
        loadDashboard();
    });

  
</script>
